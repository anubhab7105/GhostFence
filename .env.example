# GhostFence environment (copy to .env)
POSTGRES_DB=ghostfence
POSTGRES_USER=gf_admin
POSTGRES_PASSWORD=change-me-admin

GATEWAY_DB_USER=gf_gateway
GATEWAY_DB_PASSWORD=change-me-gateway
CHECKPOINTER_DB_USER=gf_checkpointer
CHECKPOINTER_DB_PASSWORD=change-me-checkpointer
TAMPER_ADMIN_DB_USER=gf_tamper_admin
TAMPER_ADMIN_DB_PASSWORD=change-me-tamper

# API keys are stored hashed by the gateway; these are dev bootstrap values.
GHOSTFENCE_ADMIN_API_KEY=dev-admin-key
GHOSTFENCE_APPROVER_API_KEY=dev-approver-key
GHOSTFENCE_AGENT_API_KEY=dev-agent-key

RUN_TOKEN_SECRET=change-me-run-token-secret
AUDIT_HMAC_KEY=change-me-audit-hmac-key

# Provider adapter (D1). Restricted data and secrets are never sent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MODEL_VERSION=pinned
DEMO_PROVIDER_APPROVED_UP_TO=confidential

# Demo-only destination allow rule (D4)
DEMO_ALLOW_EVIL_TEST=true
DEMO_MODE=false

SINK_URL=http://sink:8080
VENDOR_SITE_URL=http://vendor-site:8080
FRONTEND_ORIGIN=http://localhost:3000
GATEWAY_URL=http://gateway:8000